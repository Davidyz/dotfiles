{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "requestTimeoutMs": 30000
  },
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "keep-alive",
      "requestTimeoutMs": 30000
    },
    "canvas": {
      "command": "uvx",
      "args": [
        "canvas-api-mcp"
      ],
      "env": {
        "CANVAS_BASE_URL": "https://canvas.cityu.edu.hk",
        "CANVAS_TOKEN": "${CANVAS_TOKEN}"
      },
      "lifecycle": "keep-alive",
      "idleTimeout": 10000,
      "requestTimeoutMs": 30000,
      "excludeTools": [
        "submit_assignment",
        "post_discussion_reply",
        "canvas_request"
      ]
    }
  }
}
