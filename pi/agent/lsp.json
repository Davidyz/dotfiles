{
  "version": 1,
  "servers": [
    {
      "id": "ruff",
      "enabled": true,
      "include": [
        "**/*.py",
        "**/*.pyi"
      ],
      "rootMarkers": [
        "pyproject.toml",
        "setup.py",
        "requirements.txt",
        ".ruff.toml"
      ],
      "bin": "ruff",
      "args": [
        "server"
      ],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeoutMs": 30000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "pyrefly",
      "enabled": true,
      "include": [
        "**/*.py",
        "**/*.pyi"
      ],
      "rootMarkers": [
        "pyproject.toml",
        "setup.py",
        "requirements.txt",
        "pyrightconfig.json"
      ],
      "bin": "pyrefly",
      "args": [
        "lsp"
      ],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeoutMs": 30000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "clangd",
      "enabled": true,
      "include": [
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.hpp",
        "**/*.cc",
        "**/*.cxx"
      ],
      "rootMarkers": [
        "compile_commands.json",
        ".clangd",
        "compile_flags.txt"
      ],
      "bin": "clangd",
      "args": [
        "--background-index"
      ],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".hpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "rust-analyzer",
      "enabled": true,
      "include": [
        "**/*.rs"
      ],
      "rootMarkers": [
        "Cargo.toml",
        "rust-project.json"
      ],
      "bin": "rust-analyzer",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".rs": "rust"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
