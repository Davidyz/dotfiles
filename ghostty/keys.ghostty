keybind = alt+t=new_tab
keybind = alt+shift+t=new_tab
keybind = alt+page_down=next_tab
keybind = alt+page_up=previous_tab
keybind = alt+shift+page_down=move_tab:1
keybind = alt+shift+page_up=move_tab:-1
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = ctrl+shift+t=unbind
keybind = alt+w=close_surface
keybind = alt+shift+w=close_tab
keybind = ctrl+alt+=new_split:right
keybind = ctrl+alt+-=new_split:down
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = alt+minus=scroll_page_lines:-1
keybind = alt+equal=scroll_page_lines:1
keybind = alt+_=scroll_page_up
keybind = alt+=scroll_page_down
